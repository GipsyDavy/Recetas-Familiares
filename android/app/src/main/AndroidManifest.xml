<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Guardar imagenes del chat en galeria en API < 29; en 29+ se usa MediaStore sin permiso. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".RecetasApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Recetas Familiares"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.RecetasFamiliares">
        <!-- La activity de entrada declara LAUNCHER, asi que android:exported="true"
             es obligatorio desde API 31: sin el, la app no arranca. No acepta datos
             de terceros mas alla del intent MAIN. -->
        <!-- nosemgrep -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.RecipeWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recipe_info" />
        </receiver>

        <receiver
            android:name=".widget.StockWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stock_info" />
        </receiver>
    </application>
</manifest>
