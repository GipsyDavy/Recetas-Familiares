CREATE TABLE recipes (
    id            TEXT    NOT NULL PRIMARY KEY,
    familyId      TEXT    NOT NULL,
    title         TEXT    NOT NULL,
    description   TEXT,
    difficulty    TEXT,
    servings      INTEGER,
    prepMinutes   INTEGER,
    cookMinutes   INTEGER,
    updatedAt     TEXT    NOT NULL,
    syncVersion   INTEGER NOT NULL DEFAULT 0,
    deleted       INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE stock_items (
    id                 TEXT    NOT NULL PRIMARY KEY,
    familyId           TEXT    NOT NULL,
    name               TEXT    NOT NULL,
    quantity           REAL,
    unit               TEXT,
    expiresAt          TEXT,
    lowStockThreshold  REAL,
    note               TEXT,
    updatedAt          TEXT    NOT NULL,
    syncVersion        INTEGER NOT NULL DEFAULT 0,
    deleted            INTEGER NOT NULL DEFAULT 0
);

insertOrReplaceRecipe:
INSERT OR REPLACE INTO recipes
    (id, familyId, title, description, difficulty, servings, prepMinutes, cookMinutes, updatedAt, syncVersion, deleted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllRecipes:
SELECT * FROM recipes WHERE familyId = ? AND deleted = 0;

insertOrReplaceStockItem:
INSERT OR REPLACE INTO stock_items
    (id, familyId, name, quantity, unit, expiresAt, lowStockThreshold, note, updatedAt, syncVersion, deleted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllStockItems:
SELECT * FROM stock_items WHERE familyId = ? AND deleted = 0;

CREATE TABLE recipe_ingredients (
    id        TEXT NOT NULL PRIMARY KEY,
    recipeId  TEXT NOT NULL,
    name      TEXT NOT NULL,
    deleted   INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE sync_metadata (
    key   TEXT NOT NULL PRIMARY KEY,
    value TEXT
);

insertOrReplaceIngredient:
INSERT OR REPLACE INTO recipe_ingredients (id, recipeId, name, deleted)
VALUES (?, ?, ?, ?);

selectIngredientsByRecipeId:
SELECT * FROM recipe_ingredients WHERE recipeId = ? AND deleted = 0;

selectAllIngredientsForFamily:
SELECT recipe_ingredients.*
FROM recipe_ingredients
JOIN recipes ON recipes.id = recipe_ingredients.recipeId
WHERE recipes.familyId = ?
  AND recipes.deleted = 0
  AND recipe_ingredients.deleted = 0;

getMetadata:
SELECT value FROM sync_metadata WHERE key = ?;

setMetadata:
INSERT OR REPLACE INTO sync_metadata (key, value) VALUES (?, ?);
