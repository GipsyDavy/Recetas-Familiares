#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="/opt/recetas-familiares/backend"
RELEASES_DIR="${APP_DIR}/releases"
CURRENT_LINK="${APP_DIR}/current.jar"
SERVICE_NAME="recetas-backend.service"
HEALTH_URL="${RECETAS_BACKEND_HEALTH_URL:-http://127.0.0.1:8080/api/v1/health}"

require_root() {
  if [[ "$(id -u)" != "0" ]]; then
    echo "recetas-backend-rollback must run as root" >&2
    exit 1
  fi
}

wait_for_health() {
  local attempt
  for attempt in $(seq 1 45); do
    if curl -fsS --max-time 3 "$HEALTH_URL" 2>/dev/null | grep -q '"status"[[:space:]]*:[[:space:]]*"UP"'; then
      return 0
    fi
    sleep 2
  done
  return 1
}

point_current_to() {
  local target="$1"
  local tmp_link
  tmp_link="$(mktemp -u "${APP_DIR}/.current.jar.XXXXXX")"
  ln -s "$target" "$tmp_link"
  mv -Tf "$tmp_link" "$CURRENT_LINK"
}

main() {
  require_root

  if [[ ! -L "$CURRENT_LINK" ]]; then
    echo "current.jar is not a symlink" >&2
    exit 2
  fi

  local current_target
  current_target="$(readlink -f "$CURRENT_LINK")"

  mapfile -t release_paths < <(
    find "$RELEASES_DIR" -maxdepth 1 -type f -name '*.jar' -printf '%T@ %p\n' |
      sort -rn |
      sed 's/^[^ ]* //'
  )

  local rollback_target=""
  local release_path
  for release_path in "${release_paths[@]}"; do
    if [[ "$release_path" != "$current_target" ]]; then
      rollback_target="$release_path"
      break
    fi
  done

  if [[ -z "$rollback_target" ]]; then
    echo "no previous backend release available" >&2
    exit 2
  fi

  point_current_to "$rollback_target"
  systemctl restart "$SERVICE_NAME"

  if wait_for_health; then
    echo "rolled back to $(basename "$rollback_target" .jar)"
    exit 0
  fi

  echo "rollback health check failed; restoring original release" >&2
  point_current_to "$current_target"
  systemctl restart "$SERVICE_NAME"
  wait_for_health || true
  exit 1
}

main "$@"
