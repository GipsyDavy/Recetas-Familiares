#!/usr/bin/env bash
set -euo pipefail
umask 027
BACKUP_ROOT="${BACKUP_ROOT:-/var/backups/recetas-postgres}"
BASE_DIR="$BACKUP_ROOT/base"
RETENTION_DAYS="${RETENTION_DAYS:-21}"
TS="$(date -u +%Y%m%dT%H%M%SZ)"
TMP="$BASE_DIR/base_${TS}.tmp"
OUT="$BASE_DIR/base_${TS}"
rm -rf "$TMP"
mkdir -p "$TMP"
pg_basebackup -D "$TMP" -Ft -z -X stream -c fast
mv "$TMP" "$OUT"
chmod -R go-rwx "$OUT"
find "$BASE_DIR" -mindepth 1 -maxdepth 1 -type d -name 'base_*' -mtime +"$RETENTION_DAYS" -exec rm -rf {} +
# La purga de WAL ya no vive aqui: se movio al script diario
# (recetas-postgres-logical-backup) el 2026-07-31. Estando en este script, que
# solo corre los domingos, un fallo repetido del basebackup dejaba de purgar el
# WAL en silencio.
printf '%s\n' "$OUT"
