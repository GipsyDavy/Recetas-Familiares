#!/bin/bash
# Copia offsite cifrada (restic -> Hetzner Storage Box) de los backups locales de PostgreSQL.
# Falla cerrado: si el destino no responde, los backups locales siguen intactos.
set -euo pipefail
set -a
source /etc/recetas-familiares/offsite-backup.env
set +a
restic backup /var/backups/recetas-postgres --tag scheduled --quiet
restic forget --tag scheduled --keep-daily 14 --keep-weekly 5 --prune --quiet
# `restic check` a secas valida estructura e indices, pero nunca llega a leer los
# datos cifrados: un blob corrupto pasaria desapercibido. Con --read-data-subset
# se verifica ademas una septima parte de los blobs cada dia, rotando por el dia
# del año, de forma que en una semana se cubre el repositorio entero.
restic check --read-data-subset="$(( ($(date -u +%-j) % 7) + 1 ))/7" --quiet
